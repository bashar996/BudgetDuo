rules_version = '2';

// Tandem: two people share one household. Only its members can read or
// change it; a new member can join once, with the invite code (the doc ID).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isMember(hid) {
      return signedIn() &&
        uid() in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Each person's pointer to their household.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.members == [uid()];

      allow read, delete: if signedIn() && uid() in resource.data.members;

      allow update: if signedIn() && (
        uid() in resource.data.members ||
        // Joining with the code: only add yourself, at most two people.
        (resource.data.members.size() < 2
          && request.resource.data.members == resource.data.members.concat([uid()])
          && request.resource.data.memberWho[uid()] == 'B'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberWho']))
      );

      // Entries, accounts, bills and pots.
      match /{collection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
